# Copia este archivo a `keystore.properties` y rellénalo.
#
# `keystore.properties` y los .jks están en .gitignore y NO deben subirse
# nunca: quien tenga la clave puede publicar actualizaciones de esta app en
# nombre tuyo. Y al revés importa más todavía — si pierdes el .jks, Google no
# te deja volver a actualizar la app JAMÁS. Hay que guardarlo fuera del
# ordenador de trabajo, en dos sitios.
#
# Para crear la clave (una sola vez, y con calma):
#
#   keytool -genkey -v -keystore sismored.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias sismored
#
# 10000 días son 27 años. Play exige que la validez pase de 2033.

storeFile=../sismored.jks
storePassword=
keyAlias=sismored
keyPassword=

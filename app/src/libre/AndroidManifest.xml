<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Único mecanismo que recibe las teclas de volumen con la pantalla
             apagada y bloqueada. El usuario lo activa a mano en Ajustes.
             Exclusivo de la distribución libre (GitHub / F-Droid). -->
        <service
            android:name=".ServicioTeclas"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad" />
        </service>
    </application>

</manifest>

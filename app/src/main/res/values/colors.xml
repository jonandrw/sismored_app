<?xml version="1.0" encoding="utf-8"?>
<!-- La paleta de SismoRed.

     Rediseño completo: la app deja de parecerse a una web oscura y pasa a
     parecerse a un INSTRUMENTO DE CAMPO. Dos reglas mandan sobre todo lo demás,
     y las dos vienen de la maqueta:

     1. **Rojo solo cuando algo está emitiendo.** Deja de ser un color de marca
        repartido por la interfaz y pasa a ser información: si hay rojo en la
        pantalla, este móvil está haciendo ruido o mandando algo. En reposo no
        hay ni una pieza roja.
     2. **En reposo la pantalla es negra de verdad.** El fondo baja de #0B0D0F a
        #050708 para apagar píxel en OLED. No es estética: es la batería de
        alguien que puede necesitarla doce horas más.

     Los dos colores que NO cambian son el rojo de alarma y el verde de
     verificado, porque son los que ya reconoce quien ha usado la app. -->
<resources>
    <!-- === superficies, de atrás hacia delante === -->
    <color name="bg">#050708</color>
    <color name="card">#0D1113</color>
    <color name="card2">#161B1F</color>
    <color name="line">#1E252A</color>
    <color name="line_dark">#161C21</color>
    <color name="borde_control">#2A3238</color>

    <!-- Control apagado: un gris que se ve pero no compite con el dato. -->
    <color name="ctl">#2A3238</color>

    <!-- === texto === -->
    <!-- Subtítulos, rótulos cortos, unidades y labels mono (104 apariciones en rediseño) -->
    <color name="dim">#7C858D</color>
    <color name="tx">#FFFFFF</color>
    <color name="tx_sec">#E8EBED</color>
    <!-- Gris de LECTURA / Números mono y texto suave (87 apariciones en rediseño) -->
    <color name="lectura">#BCC3C9</color>
    <!-- Texto oscuro de contraste para botones de acción rojos (#E53035) -->
    <color name="tx_sobre_rojo">#0A0405</color>

    <!-- === estado === -->
    <!-- Emitiendo / Alarma activa / Peligro. Nunca meramente decorativo (40 apariciones). -->
    <color name="rd">#E53035</color>
    <color name="rd_d">#A81F23</color>
    <!-- Vigilando / Medido / Nodo detectado / Verificado (100 apariciones). -->
    <color name="gr">#90CA50</color>
    <!-- Precaución / Estado atrapada / Doppler (17 apariciones). -->
    <color name="ambar">#F0A02A</color>
</resources>

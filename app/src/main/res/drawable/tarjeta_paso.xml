<?xml version="1.0" encoding="utf-8"?>
<!-- La tarjeta de un paso de instrucciones.

     No vale reusar `fila_op`: es del mismo #14171A que la tarjeta que los
     contiene, así que separar los pasos con un hueco no se veía — quedaban tres
     bloques de texto flotando en el mismo fondo, que es justo lo que había antes
     con las líneas divisorias. Un paso se lee como tarjeta cuando tiene un borde
     y un tono propios; sin eso, el hueco solo es más espacio en blanco.

     El relleno es un punto por encima del fondo de la tarjeta madre y el borde
     es la misma línea que ya separaba los pasos: no se añade un color nuevo a la
     paleta, se cambia de sitio el que ya estaba. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#191D22" />
    <stroke android:width="1dp" android:color="@color/line" />
</shape>

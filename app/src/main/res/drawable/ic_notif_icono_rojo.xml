<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo cuadrado redondeado rojo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E53035" />
            <corners android:radius="9dp" />
            <size android:width="34dp" android:height="34dp" />
        </shape>
    </item>
    <!-- Aguja vertical blanca -->
    <item
        android:left="15dp"
        android:right="15dp"
        android:top="6dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Aguja diagonal blanca -->
    <item
        android:left="6dp"
        android:right="6dp"
        android:top="15dp"
        android:bottom="16dp">
        <rotate
            android:fromDegrees="-22"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#FFFFFF" />
            </shape>
        </rotate>
    </item>
</layer-list>

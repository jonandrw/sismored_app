<?xml version="1.0" encoding="utf-8"?>
<!-- La sonda: el barrido del sonar y el eco que vuelve.

     Con circulos concentricos era el mismo dibujo que la malla y en la rejilla
     no habia forma de distinguirlos. Y son cosas distintas: la malla habla con
     otros moviles y la sonda mira el hueco donde estas. El barrido lo dice.

     Caja de 30, trazo 2 y la tinta centrada en (15,15) ocupando 22 de 30,
     como los otros cinco. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="30dp"
    android:height="30dp"
    android:viewportWidth="30"
    android:viewportHeight="30"
    android:tint="#BCC3C9">

    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M15,4a11,11 0 1,0 0.001,0" />

    <!-- la aguja del barrido, desde el centro -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M15,15L22.8,7.2" />

    <!-- el eco que devuelve una superficie -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.5,18a1.8,1.8 0 1,0 0.001,0" />
</vector>

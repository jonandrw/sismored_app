<?xml version="1.0" encoding="utf-8"?>
<!-- El vidrio de la maqueta, en rojo. No hay desenfoque real en una vista de
     Android, así que lo que da la sensación de cristal es el degradado
     translúcido más el filo encendido: más rojo donde está la magnitud y
     apagándose hacia el texto, para que el ojo caiga primero en el número. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#1CE53035"
        android:endColor="#08E53035"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#33E53035" />
    <corners android:radius="8dp" />
</shape>

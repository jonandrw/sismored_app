<?xml version="1.0" encoding="utf-8"?>
<!-- El vidrio de la maqueta, en rojo: un velo translúcido sobre el fondo con
     el borde apenas encendido. No hay desenfoque real en una vista de Android,
     así que lo que da la sensación de cristal es la transparencia baja más el
     filo claro, igual que en las tarjetas de la pantalla principal. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#14E53035" />
    <stroke android:width="1dp" android:color="#3DE53035" />
    <corners android:radius="6dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- El cuadro de la magnitud. Separarlo del resto de la tarjeta es lo que le
     da jerarquía: sin él el número flota y la fila se lee plana. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#26E53035" />
    <stroke android:width="1dp" android:color="#59E53035" />
    <corners android:radius="6dp" />
</shape>

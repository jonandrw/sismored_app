<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo cuadrado redondeado oscuro con borde -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161B1F" />
            <stroke android:width="1dp" android:color="#2A3238" />
            <corners android:radius="8dp" />
            <size android:width="30dp" android:height="30dp" />
        </shape>
    </item>
    <!-- Aguja vertical gris claro -->
    <item
        android:left="13.5dp"
        android:right="13.5dp"
        android:top="8dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#BCC3C9" />
        </shape>
    </item>
    <!-- Aguja diagonal gris claro -->
    <item
        android:left="6dp"
        android:right="6dp"
        android:top="14dp"
        android:bottom="14dp">
        <rotate
            android:fromDegrees="-22"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="#BCC3C9" />
            </shape>
        </rotate>
    </item>
</layer-list>

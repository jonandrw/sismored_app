<?xml version="1.0" encoding="utf-8"?>
<!-- Desde Android 8 el lanzador recorta el icono con la forma que tenga el
     móvil (círculo, cuadrado redondeado, gota). Sin icono adaptativo mete el
     PNG cuadrado dentro de una placa blanca con sombra, que con un logotipo
     sobre negro se ve como un sello pegado y además le come los bordes.

     El fondo va en negro liso, el mismo de la app, y el logotipo se queda
     dentro de la zona segura de 72 dp: así ninguna forma lo corta. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icono_fondo" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>

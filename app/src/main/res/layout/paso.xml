<?xml version="1.0" encoding="utf-8"?>
<!-- Un paso de CÓMO USARLA: icono propio a la izquierda, número y texto.

     Cada paso lleva SU icono, no uno genérico repetido: el de la ficha es una
     persona, el del atajo es el botón lateral del móvil, el del rescate es un
     casco. Quien abre la app por primera vez reconoce el dibujo antes de leer
     la frase, y eso es justo lo que hace falta cuando hay prisa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/ps_icono"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="1dp"
        android:contentDescription="@null"
        android:tint="@color/gr" />

    <TextView
        android:id="@+id/ps_num"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/tx"
        android:textSize="13sp" />

    <!-- Título y cuerpo, no un bloque plano. Un paso es una instrucción: primero
         QUÉ hay que hacer, en negrita y en color de texto, y debajo el por qué en
         gris. Antes todo iba con el mismo peso y el mismo tamaño, y la jerarquía se
         intentaba con MAYÚSCULAS y puntos medios, que no es jerarquía: es una línea
         larga.

         `hyphenationFrequency="none"` y `breakStrategy="simple"` tampoco son
         adorno: por defecto Android parte palabras con guion al final de línea, y
         en una columna estrecha eso deja trozos de palabra sueltos. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ps_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:fontFamily="@font/montserrat_bold"
            android:hyphenationFrequency="none"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/tx"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ps_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:lineSpacingMultiplier="1.5"
            android:textColor="@color/dim"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Elemento de hallazgo de superviviente (Pantalla 06 · Buscar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_hallazgo_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tarjeta"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Avatar / Insignia Sangre (38dp circular) -->
    <FrameLayout
        android:id="@+id/hz_insignia_fondo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/badge_sangre_verde">

        <TextView
            android:id="@+id/hz_sangre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/mono"
            android:text="@string/guion"
            tools:text="0−"
            android:textColor="#90CA50"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Datos Centrales (Nombre + Estado) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hz_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/saira"
            android:letterSpacing="0.03"
            android:text="@string/guion"
            tools:text="MARTA"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hz_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/mono"
            android:text=""
            tools:text="ATRAPADA · CONSCIENTE"
            android:textColor="#F0A02A"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Indicador RSSI Derecha (Mini Gráfico Animado + Cifra dBm) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <red.sismo.VistaMiniRssi
            android:id="@+id/hz_mini_rssi"
            android:layout_width="22dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hz_rssi_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono"
                android:text="@string/guion"
                tools:text="−58"
                android:textColor="#90CA50"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hz_rssi_unidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono"
                android:text=""
                tools:text="dBm"
                android:textColor="#7C858D"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Un móvil oído por el rastreador.

     La barra NO es distancia y por eso no lleva ninguna unidad: convertir dBm a
     metros asume espacio libre, y entre el que busca y el que está debajo hay
     hormigón y hierro. Lo que guía de verdad es la flecha: si al dar tres pasos
     sube, vas bien. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/caja"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hz_tendencia"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:textColor="@color/gr"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hz_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/tx"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hz_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/dim"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hz_dbm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/tx"
            android:textSize="17sp" />
    </LinearLayout>

    <red.sismo.VistaBarra
        android:id="@+id/hz_barra"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/hz_ficha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/rd"
        android:textSize="12.5sp"
        android:visibility="gone" />
</LinearLayout>

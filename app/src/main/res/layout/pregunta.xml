<?xml version="1.0" encoding="utf-8"?>
<!-- «¿ESTÁS BIEN?» tras el disparo sísmico (Maqueta 14).
     Diseño de alto impacto: fondo oscuro, titular en Saira, contador en Mono
     con la onda concéntrica y botones de respuesta inequívocos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <red.sismo.VistaOndaCuenta
        android:id="@+id/pr_onda"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Píldora de motivo de disparo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_ambar"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/punto_estado"
                    android:backgroundTint="@color/ambar" />

                <TextView
                    android:id="@+id/pr_motivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono"
                    android:letterSpacing="0.16"
                    android:text="@string/pr_rotulo"
                    android:textColor="@color/ambar"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Titular de impacto -->
            <TextView
                android:id="@+id/pr_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/saira"
                android:gravity="center"
                android:letterSpacing="-0.015"
                android:lineSpacingMultiplier="0.9"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="2"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/pr_titulo"
                android:textAllCaps="true"
                android:textColor="@color/tx"
                android:textSize="64sp"
                android:textStyle="bold|italic" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/barlow"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/pr_sub"
                android:textColor="@color/lectura"
                android:textSize="16sp" />

            <!-- Contador circular central -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/chip"
                android:backgroundTint="#0D1113">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pr_cuenta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mono"
                        android:text="20"
                        android:textColor="@color/tx"
                        android:textSize="64sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mono"
                        android:letterSpacing="0.2"
                        android:text="@string/pr_cuenta_sub"
                        android:textColor="@color/dim"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Botón 1: ESTOY BIEN -->
            <LinearLayout
                android:id="@+id/pr_bien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/tarjeta"
                android:backgroundTint="#24282D"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/saira"
                    android:letterSpacing="0.02"
                    android:text="@string/pr_bien"
                    android:textAllCaps="true"
                    android:textColor="@color/tx"
                    android:textSize="28sp"
                    app:autoSizeMaxTextSize="28sp"
                    app:autoSizeMinTextSize="17sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:textStyle="bold|italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/mono"
                    android:letterSpacing="0.14"
                    android:text="@string/pr_bien_sub"
                    android:textColor="@color/lectura"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Botón 2: NECESITO AYUDA -->
            <LinearLayout
                android:id="@+id/pr_ayuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tarjeta"
                android:backgroundTint="@color/rd"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/saira"
                    android:letterSpacing="0.02"
                    android:text="@string/pr_ayuda"
                    android:textAllCaps="true"
                    android:textColor="#0A0405"
                    android:textSize="28sp"
                    app:autoSizeMaxTextSize="28sp"
                    app:autoSizeMinTextSize="17sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:textStyle="bold|italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/mono"
                    android:letterSpacing="0.14"
                    android:text="@string/pr_ayuda_sub"
                    android:textColor="#800A0405"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/barlow"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/pr_volumen"
                android:textColor="@color/dim"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

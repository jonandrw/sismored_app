<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<!-- Cabecera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mono"
                android:letterSpacing="0.2"
                android:text="FICHA MÉDICA"
                android:textColor="#6B7278"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_rd_outline"
                android:fontFamily="@font/mono"
                android:letterSpacing="0.14"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="SIN DESBLOQUEAR"
                android:textColor="#E53035"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Nombre en Saira grande (mayúsculas, max 2 líneas) -->
        <TextView
            android:id="@+id/ff_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/saira"
            android:letterSpacing="-0.015"
            android:lineSpacingMultiplier="0.92"
            android:maxLines="2"
            android:text="MARTA\nFERRÁN"
            android:textAllCaps="true"
            android:textColor="#0B0D0F"
            android:textSize="58sp"
            android:textStyle="bold|italic"
            app:autoSizeMaxTextSize="62sp"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform" />

        <!-- Fila Grupo y Edad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Grupo Sanguíneo en Rojo con chaflán superior derecho 14dp -->
            <red.sismo.TarjetaGrupoLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono"
                    android:letterSpacing="0.18"
                    android:text="GRUPO"
                    android:textColor="#D0FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/ff_sangre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono"
                    android:text="0−"
                    android:textColor="#FFFFFF"
                    android:textSize="52sp"
                    android:textStyle="bold" />
            </red.sismo.TarjetaGrupoLayout>

            <!-- Edad en Blanco -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/campo_fondo_blanco"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono"
                    android:letterSpacing="0.18"
                    android:text="EDAD"
                    android:textColor="#6B7278"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/ff_edad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/mono"
                    android:text="34"
                    android:textColor="#0B0D0F"
                    android:textSize="52sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <!-- Tarjeta ALERGIAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F3F4F6"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono"
                android:letterSpacing="0.18"
                android:text="ALERGIAS"
                android:textColor="#7C858D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/ff_alergias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/barlow"
                android:lineSpacingMultiplier="1.2"
                android:text="Penicilina · Látex"
                android:textColor="#0A0D0F"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tarjeta MEDICACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F3F4F6"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono"
                android:letterSpacing="0.18"
                android:text="MEDICACIÓN"
                android:textColor="#7C858D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/ff_med"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/barlow"
                android:lineSpacingMultiplier="1.2"
                android:text="Anticoagulante diario"
                android:textColor="#0A0D0F"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tarjeta CONTACTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F3F4F6"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mono"
                android:letterSpacing="0.18"
                android:text="CONTACTO"
                android:textColor="#7C858D"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/ff_contacto_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/barlow"
                android:text="Luis Ferrán"
                android:textColor="#0A0D0F"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ff_contacto_tel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/mono"
                android:text="+34 612 88 40 21"
                android:textColor="#0A0D0F"
                android:textSize="18sp" />
        </LinearLayout>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<!-- Una tarjeta de vidrio rojo por sismo. La magnitud va en su propio cuadro
     porque es lo único que se lee de un vistazo cuando acabas de notar algo;
     debajo, en pequeño, cuánto hace, que es la segunda pregunta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/vidrio_rojo"
    android:gravity="center_vertical"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="9dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="13dp"
        android:background="@drawable/pastilla_mag"
        android:gravity="center"
        android:minWidth="66dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/tv_mag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mono"
            android:text=""
            tools:text="4.6"
            android:textColor="@color/tx"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_mag_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mono"
            android:letterSpacing="0.14"
            android:text="@string/hist_magnitud"
            android:textColor="#9AE53035"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/barlow"
            android:maxLines="2"
            android:text=""
            tools:text="Sipí - Chocó, Colombia"
            android:textColor="@color/tx"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_fecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/mono"
            android:letterSpacing="0.03"
            android:maxLines="2"
            android:text=""
            tools:text="74 km · hace 2 h · SGC"
            android:textColor="@color/dim"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Sin ver. Un punto y no un color de tarjeta distinto: la lista tiene
         que seguir leyéndose igual cuando ya se ha mirado todo. -->
    <View
        android:id="@+id/punto_nuevo"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/punto_rojo" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- FICHA MÉDICA a pantalla completa (Maqueta 09).
     Fondo claro #F2F4F5 y máximo contraste para legibilidad en luz de día, polvo y escombros. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F5"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        
        <include layout="@layout/ficha_campos" />

        <!-- Botón ME HAN ENCONTRADO -->
        <Button
            android:id="@+id/ff_encontrado"
            style="@style/Boton.UnaLinea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="#0B0D0F"
            android:minHeight="60dp"
            android:text="@string/ff_encontrado"
            android:textColor="@color/gr"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ff_pie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/barlow"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="Estos datos se guardan solo en este móvil. Salen por radio únicamente con la alarma o el modo rescate activos."
            android:textColor="#7C858D"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

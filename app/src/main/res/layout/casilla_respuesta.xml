<?xml version="1.0" encoding="utf-8"?>
<!-- Una casilla de HERRAMIENTAS DE RESPUESTA.

     Antes eran seis bloques idénticos con un icono, un nombre y un ON/OFF
     minúsculo: para saber cuáles estaban encendidas había que leerlas una a una,
     y «Modo rescate» —que cambia la autonomía durante días— pesaba lo mismo que
     «Vibración».

     Ahora el estado se ve sin leer: encendida se RELLENA y se tiñen el icono y
     el rótulo. Y cada una dice en una línea qué hace, porque «Pantalla» no
     significa nada por sí solo. -->
<!-- OJO con el alto: `match_parent` solo vale porque la FILA que la contiene
     tiene un alto fijo (`@dimen/casilla_alto`). Dentro de una fila en
     `wrap_content`, `match_parent` mide CERO y la casilla desaparece sin dar
     ningún error — es lo que hizo que solo se viera «Modo rescate». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/casilla"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="18dp">

    <ImageView
        android:id="@+id/cs_icono"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="@null"
        android:tint="@color/ctl" />

    <TextView
        android:id="@+id/cs_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_semibold"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/tx"
        android:textSize="14.5sp" />

    <!-- Qué hace, en una línea. Sin esto el nombre es una etiqueta muda. -->
    <TextView
        android:id="@+id/cs_que"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:lineSpacingMultiplier="1.3"
        android:textColor="@color/dim"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="12dp" />

    <TextView
        android:id="@+id/cs_estado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:letterSpacing="0.133"
        android:text="@string/off"
        android:textColor="@color/ctl"
        android:textSize="10.5sp" />
</LinearLayout>

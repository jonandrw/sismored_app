<?xml version="1.0" encoding="utf-8"?>
<!-- El interruptor de una herramienta de la sonda: ancho completo, con su rótulo
     a la izquierda, el estado en palabras y la pista con el pomo a la derecha.

     Es el mismo mecanismo que `conmutador` (el del detector automático), pero a
     todo lo ancho y con el estado escrito. Aquí hace falta la palabra: un pomo
     desplazado 20 px es todo lo que distingue «emitiendo un tono que casi no oigo»
     de «apagado», y eso no se ve de reojo con guantes y polvo.

     Se rellena por código con cm_texto / cm_estado / cm_pista / cm_pomo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/campo_fondo"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cm_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold"
            android:letterSpacing="0.04"
            android:textColor="@color/tx"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cm_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:letterSpacing="0.095"
            android:textColor="@color/dim"
            android:textSize="10.5sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cm_pista"
        android:layout_width="48dp"
        android:layout_height="26dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/sw_pista">

        <View
            android:id="@+id/cm_pomo"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="@color/dim" />
    </FrameLayout>
</LinearLayout>

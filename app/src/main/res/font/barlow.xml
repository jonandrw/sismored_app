    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/barlow_regular" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/barlow_medium" />
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/barlow_semibold" />
</font-family>

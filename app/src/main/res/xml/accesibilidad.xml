<?xml version="1.0" encoding="utf-8"?>
<!-- flagRequestFilterKeyEvents + canRequestFilterKeyEvents son lo que permite
     recibir las teclas de volumen con la pantalla apagada. Sin los dos, onKeyEvent
     no se llama nunca. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagDefault"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/desc_teclas"
    android:notificationTimeout="100" />

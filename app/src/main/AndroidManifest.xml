<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- El servicio en primer plano es lo que mantiene la app viva con la
         pantalla bloqueada. Sin esto, nada de lo demás importa. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Malla acústica: se escucha la banda de 16-18 kHz para recibir balizas de
         otros móviles. No se graba ni se guarda nada; el audio se analiza en
         marcos de 42 ms y se descarta. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para que «¿ESTÁS BIEN?» salga a pantalla completa con el móvil
         bloqueado. Desde Android 14 este permiso ya no se concede solo salvo a
         apps de llamada o de alarma, así que puede estar denegado: la app lo
         comprueba con `canUseFullScreenIntent()`, lo dice en Diagnóstico y, si no
         lo tiene, la pregunta sigue llegando como aviso normal. Nunca se queda
         sin preguntar. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Los pasos. Es un contador que ya está corriendo en el coprocesador de
         sensores de todos los móviles, con la pantalla apagada y sin gastar
         nada; lo único que hace falta es permiso para leerlo. Sirve para saber
         si alguien SIGUE ANDANDO después del terremoto, que es la prueba más
         barata de que está bien. No sale del móvil. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Subir el canal de alarma al máximo y enganchar el realce de volumen a la
         sesión de la sirena. Sin esto la sirena suena al volumen que hubiera
         dejado puesto el usuario, que puede ser cero. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Para que Doze no mate el servicio mientras alguien pide ayuda. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- La app funciona entera sin red y no la usa nunca por su cuenta. Estos dos
         permisos existen solo para SI APARECE INTERNET, que el usuario tiene que
         encender a mano y que manda tres campos: hora, motivo y saltos. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- La ficha completa por Wi-Fi va por difusión UDP, y para RECIBIR una
         difusión hace falta este permiso: sin él no se puede coger el
         `MulticastLock`, y sin ese candado el chip de Wi-Fi descarta los
         paquetes de difusión antes de que Android los vea. No da error, no da
         aviso y no llega nada — y depende del fabricante, así que en un móvil
         parecía funcionar y en otro no. Los dos son de sistema, no se le piden
         al usuario, y no dan acceso a ninguna red. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- La linterna se controla con CameraManager.setTorchMode, que NO exige el
         permiso CAMERA. Se declara opcional para no dejar fuera a los móviles
         sin flash: todo lo demás les sigue funcionando igual. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- Baliza de radio para que te encuentren desde arriba. La malla acústica
         dice a cuántos saltos estás; esto dice hacia dónde, porque la potencia
         sube al acercarse. `neverForLocation` es literal: SismoRed no deduce
         ubicaciones de lo que escanea, solo mira si la señal sube o baja. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Hasta Android 11 el sistema exigía estos tres para lo mismo. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Ubicación. Y aquí hay que ser exacto, porque esto cambia una promesa:
         SismoRed **nunca enciende el GPS**. No hay una sola llamada a
         `requestLocationUpdates` en todo el proyecto; lo único que se lee es
         `getLastKnownLocation`, o sea un arreglo que ya hizo otra app. No hay
         seguimiento ni histórico: solo dónde estaba el móvil la última vez que
         alguien miró, que es lo que convierte un barrio en un portal cuando
         alguien te busca. Se guarda en el móvil y sale con la misma regla que la
         ficha: solo con la alarma o el rescate activos.
         Ya no lleva maxSdkVersion: antes solo existía para el escaneo BLE de
         Android 11 y ahora tiene un uso propio. `neverForLocation` en el escaneo
         sigue siendo literal — de lo que se escanea no se deduce nada. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SismoRed">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- «¿ESTÁS BIEN?». Sale sobre la pantalla de bloqueo y enciende el
             móvil, igual que una llamada entrante: si hubiera que desbloquear
             para contestar, mucha gente no llegaría a tiempo y su baliza se
             encendería sin hacer falta. No aparece en recientes —no es una
             pantalla a la que se vuelva— y no se puede exportar: la lanza el
             servicio y nadie más. -->
        <activity
            android:name=".PreguntaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <!-- La ficha médica a pantalla completa, abierta sola cuando el rescate
             ya está encima. Mismas banderas que la pregunta: sobre el bloqueo y
             encendiendo el móvil, porque quien llega hasta ti se encuentra un
             teléfono bloqueado y no puede hacer nada con él. -->
        <activity
            android:name=".FichaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />

        <activity
            android:name=".HistorialActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- stopWithTask=false es lo que hace que la vigilancia sobreviva a que
             alguien deslice la app fuera de recientes por error. Sin esto,
             cerrar la pantalla mataba el servicio y con él la sirena, la malla y
             el atajo de volumen — justo lo que la app existe para mantener. -->
        <service
            android:name=".ServicioSos"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback|microphone" />

        <!-- Único mecanismo que recibe las teclas de volumen con la pantalla
             apagada y bloqueada. El usuario lo activa a mano en Ajustes. -->
        <service
            android:name=".ServicioTeclas"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accesibilidad" />
        </service>

        <!-- Oír la alerta sísmica de Google. No hay API pública para leerla, así
             que el único camino es la notificación.

             Es el permiso más grande que pide la app y por eso NO se pide en la
             bienvenida ni se enciende solo: está apagado hasta que alguien lo
             active a mano en Ajustes, y la app funciona entera sin él. Lo que
             hace la clase está acotado a una sola línea de código —si el paquete
             no es el de los servicios de Google, se sale antes de mirar nada— y
             escrito con esas mismas palabras en Acerca de. -->
        <service
            android:name=".AlertaGoogle"
            android:exported="true"
            android:label="@string/alerta_google_titulo"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
